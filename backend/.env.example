# Kopieer naar .env voor lokale ontwikkeling. Zet géén echte secrets in de repo.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/uzk

# Azure regelt de login (Easy Auth); lokaal staat die niet aan.
# In Azure moet dit true blijven, anders is de app zonder login bereikbaar.
AUTH_VEREIST=false
DEV_GEBRUIKER=lokale-ontwikkelaar

OPSLAG_PAD=./data
MINIMUMLOON=14.40
