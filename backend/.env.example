# Kopieer naar .env voor lokale ontwikkeling. Zet géén echte secrets in de repo.

# Lokaal via docker compose; in productie de Supabase-connectiestring
# (Session pooler), met postgresql+psycopg:// in plaats van postgresql://
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/uzk

# Lokaal zonder inloggen werken. In productie MOET dit true zijn.
AUTH_VEREIST=false
DEV_GEBRUIKER=lokaal@kwekerijbaas.nl

# Supabase -> Project Settings -> API (alleen nodig als AUTH_VEREIST=true)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Ondertekent het sessiecookie. In productie een lange, willekeurige waarde.
SESSIE_GEHEIM=onveilig-standaard-geheim-alleen-voor-lokaal
# Lokaal zonder https: uit. In productie aan laten.
COOKIE_SECURE=false

TOEGESTANE_DOMEINEN=["kwekerijbaas.nl"]
TOEGESTANE_EMAILS=[]

OPSLAG_PAD=./data
MINIMUMLOON=14.40
